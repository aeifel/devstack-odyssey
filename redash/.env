# PostgreSQL RDS credentials
REDASH_DATABASE_URL=postgresql://postgres:postgres@redash-postgres/postgres

# Redis (if using AWS ElastiCache), else use container redis
REDASH_REDIS_URL=redis://redash-redis:6379/0

# Required secrets
REDASH_COOKIE_SECRET=your_random_cookie_secret
REDASH_SECRET_KEY=your_random_secret_key

# Optional configs
REDASH_LOG_LEVEL=INFO
REDASH_HOST=http://localhost:5000

PYTHONUNBUFFERED=0
REDASH_RATELIMIT_ENABLED=false
